# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# AutoGLM local environment
.autoglm-venv/

# Local Midscene diagnostic artifacts; production file logging is disabled.
midscene_run/
.mobile-acceptance/

# Playwright MCP browser debugging artifacts.
.playwright-mcp/

# Test pollution: a literal "~" directory appears when an unexpanded ~ path is passed as HOME.
clients/desktop/~/

# Local verification and private recovery artifacts
/output/
/runtime/dist-independent-review/

references/

# Self-operated services are kept local, outside the public source tree.
/services/
