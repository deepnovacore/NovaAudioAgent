{
  "schema_version": 1,
  "description": "Memory items handed to the compressor. Expected prompt is exported by Python model_adapters.GatewayCompressor and matched byte for byte by Node.",
  "scenarios": [
    {
      "id": "sorted-keys-and-float-ts",
      "covers": "Integer-like content keys sort by code point and an integral float ts renders without a decimal point, because the oracle serializes with prompt_json rather than json.dumps. Both are properties a naive port loses in opposite directions.",
      "items": [
        {
          "channel": "conversation",
          "seq": 1,
          "ts": 1.0,
          "trust": "trusted_user",
          "priority": 100,
          "content": {
            "text": "把灯调暗",
            "2": "two",
            "10": "ten"
          },
          "outcome": null,
          "refs": []
        },
        {
          "channel": "slow_sim",
          "seq": 3,
          "ts": 12.0,
          "trust": "trusted_system",
          "priority": 50,
          "content": {
            "op": "set_light",
            "brightness": 30
          },
          "outcome": "ok",
          "refs": [
            "conversation:1"
          ]
        }
      ]
    },
    {
      "id": "empty",
      "covers": "No items renders an empty JSON array rather than an empty string.",
      "items": []
    },
    {
      "id": "nested-and-unicode",
      "covers": "Nested objects, arrays, escapes, and non-ASCII left literal.",
      "items": [
        {
          "channel": "codex",
          "seq": 7,
          "ts": 0.5,
          "trust": "untrusted_external",
          "priority": 30,
          "content": {
            "nested": {
              "b": [
                1,
                2.5,
                null,
                true
              ],
              "a": "他说\"客厅\""
            },
            "emoji": "😀",
            "number_spellings": {
              "integral_float": 1.0,
              "negative_zero": -0.0,
              "upper": 1e+16,
              "lower": 1e-05
            }
          },
          "outcome": "failed",
          "refs": [
            "codex:6",
            "conversation:2"
          ]
        }
      ]
    }
  ]
}
