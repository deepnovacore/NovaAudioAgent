{
  "name": "@nova-audio-agent/runtime",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./executors/codex/version": {
      "types": "./dist/src/executors/codex/version.d.ts",
      "default": "./dist/src/executors/codex/version.js"
    },
    "./desktop": {
      "types": "./dist/src/desktop.d.ts",
      "default": "./dist/src/desktop.js"
    }
  },
  "bin": {
    "nova-audio-agent-node": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/eval"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "server": "node dist/src/server-entry.js",
    "server:pair": "node scripts/pair-device.mjs",
    "test:pair": "node --test scripts/pair-device.test.mjs",
    "server:token-init": "node dist/src/server-entry.js token-init",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "demo": "npm run build && node dist/src/cli.js demo",
    "fixtures:check": "npm run build && node dist/src/cli.js fixture check",
    "lint": "eslint src eval test",
    "smoke:qwen": "npm run build && node scripts/live-smoke.mjs --target=qwen",
    "smoke:cascaded": "npm run build && node scripts/live-smoke.mjs --target=cascaded",
    "smoke:qwen:surrogate": "npm run build && node scripts/live-smoke.mjs --target=qwen-surrogate",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:win": "npm run build && node scripts/test-windows.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:search:mcp": "npm run build && node scripts/live-smoke.mjs --target=search-mcp",
    "smoke:knowledge": "npm run build && node scripts/live-smoke.mjs --target=knowledge",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "test:live:contract": "npm run build && node --test scripts/live/*contract.test.mjs",
    "test:win:platform": "npm run build && node scripts/test-windows.mjs --platform-only"
  },
  "dependencies": {
    "@livekit/agents": "1.6.4",
    "@livekit/local-inference": "0.2.7",
    "@livekit/rtc-node": "0.13.33",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.11.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.2",
    "mem0ai": "3.2.0",
    "pdfjs-dist": "6.2.108",
    "pg": "8.11.3",
    "qrcode": "1.5.4",
    "saxes": "^6.0.0",
    "undici": "7.29.0",
    "voicemem": "0.0.1",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1"
  }
}
