{
  "name": "@nova-audio-agent/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./desktop": {
      "types": "./dist/src/desktop.d.ts",
      "default": "./dist/src/desktop.js"
    }
  },
  "bin": {
    "nova-audio-agent-node": "./dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "demo": "npm run build && node dist/src/cli.js demo",
    "fixtures:check": "npm run build && node dist/src/cli.js fixture check",
    "lint": "eslint src test",
    "smoke:qwen": "npm run build && node scripts/qwen-live-smoke.mjs",
    "smoke:qwen:routing": "npm run build && node scripts/qwen-progress-routing-live-smoke.mjs",
    "smoke:qwen:surrogate": "npm run build && node scripts/qwen-surrogate-progress-live-smoke.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "1.6.4",
    "@livekit/rtc-node": "0.13.33",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
