{
  "name": "@nova-audio-agent/monorepo",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "runtime",
    "clients/desktop",
    "cli"
  ],
  "scripts": {
    "start:client": "node scripts/start-client.mjs",
    "start:workbench": "node scripts/start-client.mjs --workbench",
    "start:client_demo": "node scripts/start-client-demo.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck --workspace @nova-audio-agent/runtime && npm run lint --workspace @nova-audio-agent/runtime && npm run check:env-contract && node --test clients/desktop/test/wire-frame-types.test.mjs && node runtime/scripts/check-capabilities.mjs --check",
    "check:env-contract": "npm run build --workspace @nova-audio-agent/runtime && node runtime/scripts/check-env-contract.mjs --check",
    "fixtures:schema": "npm run build --workspace @nova-audio-agent/runtime && node runtime/scripts/generate-fixture-schema.mjs",
    "fixtures:schema:session": "npm run build --workspace @nova-audio-agent/runtime && node runtime/scripts/generate-session-fixture-schema.mjs",
    "package:linux": "npm run package:linux --workspace @nova-audio-agent/desktop",
    "package:mac": "npm run package:mac --workspace @nova-audio-agent/desktop",
    "package:mac:candidate": "npm run package:mac:candidate --workspace @nova-audio-agent/desktop",
    "package:win": "npm run package:win --workspace @nova-audio-agent/desktop",
    "runtime:demo": "npm run demo --workspace @nova-audio-agent/runtime",
    "runtime:fixtures": "npm run fixtures:check --workspace @nova-audio-agent/runtime",
    "runtime:smoke:qwen": "npm run smoke:qwen --workspace @nova-audio-agent/runtime",
    "test": "npm run test:runtime && npm run test:desktop && npm run test:cli && npm run test:server-cli",
    "test:cli": "npm test --workspace nova-audio-agent",
    "test:desktop": "npm test --workspace @nova-audio-agent/desktop",
    "test:runtime": "npm test --workspace @nova-audio-agent/runtime",
    "test:runtime:win": "npm run test:win --workspace @nova-audio-agent/runtime",
    "runtime:smoke:search:mcp": "npm run smoke:search:mcp --workspace @nova-audio-agent/runtime",
    "test:runtime:win:platform": "npm run test:win:platform --workspace @nova-audio-agent/runtime",
    "test:server-cli": "node --test server-cli/test/*.test.mjs",
    "pack:server": "npm run build --workspace @nova-audio-agent/runtime && node scripts/pack-server.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
