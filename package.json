{
  "name": "nova-audio-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "runtime",
    "desktop/ambient-orb"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck --workspace @nova-audio-agent/runtime && npm run lint --workspace @nova-audio-agent/runtime",
    "fixtures:schema": "npm run build --workspace @nova-audio-agent/runtime && node runtime/scripts/generate-fixture-schema.mjs",
    "runtime:demo": "npm run demo --workspace @nova-audio-agent/runtime",
    "runtime:fixtures": "npm run fixtures:check --workspace @nova-audio-agent/runtime",
    "test": "npm run test:runtime && npm run test:desktop",
    "test:runtime": "npm test --workspace @nova-audio-agent/runtime",
    "test:desktop": "npm test --workspace @nova-audio-agent/ambient-orb",
    "package:mac": "npm run package:mac --workspace @nova-audio-agent/ambient-orb",
    "package:win": "npm run package:win --workspace @nova-audio-agent/ambient-orb",
    "package:linux": "npm run package:linux --workspace @nova-audio-agent/ambient-orb"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
