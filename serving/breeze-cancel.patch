+class ClosingStreamingResponse(StreamingResponse):
+    """Own generator cleanup even when the client disconnects before iteration."""
+    def __init__(self, content, *, cleanup, **kwargs):
+        super().__init__(content, **kwargs)
+        self._source = content
+        self._cleanup = cleanup
+
+    async def __call__(self, scope, receive, send):
+        try:
+            await super().__call__(scope, receive, send)
+        finally:
+            # Shield cleanup from the disconnect's cancellation scope. Starlette has
+            # joined its non-abandoning iterator thread before returning here.
+            with anyio.CancelScope(shield=True):
+                try:
+                    await run_in_threadpool(self._source.close)
+                finally:
+                    self._cleanup()
 
 
