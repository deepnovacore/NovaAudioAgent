# Required for the text model and CLI demos.
NOVA_AUDIO_AGENT_MODEL_API_KEY=
# Optional model overrides (defaults shown; see docs/getting-started.md for the full reference).
#NOVA_AUDIO_AGENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#NOVA_AUDIO_AGENT_FAST_MODEL=qwen3-vl-plus
#NOVA_AUDIO_AGENT_SURROGATE_MODEL=qwen-flash
#NOVA_AUDIO_AGENT_COMPRESSOR_MODEL=qwen-flash
#NOVA_AUDIO_AGENT_WATCH_MODEL=

# Required for realtime voice. DASHSCOPE_API_KEY may be shared with the model key.
DASHSCOPE_API_KEY=
NOVA_AUDIO_AGENT_QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
NOVA_AUDIO_AGENT_QWEN_REALTIME_VOICE=longanqian

# Required for web search.
TAVILY_API_KEY=

# Optional executor configuration.
NOVA_AUDIO_AGENT_EXECUTOR=fast_sim
NOVA_AUDIO_AGENT_EXECUTORS=
NOVA_AUDIO_AGENT_HA_URL=
NOVA_AUDIO_AGENT_HA_TOKEN=
NOVA_AUDIO_AGENT_HA_ENTITY_ID=
NOVA_AUDIO_AGENT_CODEX_WORKSPACE=
NOVA_AUDIO_AGENT_CODEX_BIN=codex
#NOVA_AUDIO_AGENT_CODEX_API_KEY=
#NOVA_AUDIO_AGENT_CODEX_PREWARM=true
# Opt-in named workspaces and persistent Codex Sessions (one task globally at a time).
#NOVA_AUDIO_AGENT_CODEX_PROJECTS_ENABLED=false
#NOVA_AUDIO_AGENT_CODEX_MANAGED_ROOT=~/NovaWorkspaces
#NOVA_AUDIO_AGENT_CODEX_PROJECT_STATE_ROOT=~/.nova-audio-agent

# Optional AutoGLM configuration.
NOVA_AUDIO_AGENT_AUTOGLM_REPO=thirdparty/Open-AutoGLM
NOVA_AUDIO_AGENT_AUTOGLM_PYTHON=.autoglm-venv/bin/python
NOVA_AUDIO_AGENT_AUTOGLM_API_KEY=
NOVA_AUDIO_AGENT_AUTOGLM_DEVICE_ID=
