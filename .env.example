# AUTOGLM_API_KEY=
# AUTOGLM_MAX_STEPS=30
# AUTOGLM_TIMEOUT_SECONDS=600

# --- Planning, proactive suggestions and progress ---
# CLARIFICATION_DEPTH=balanced
