# Generated public configuration inventory. Copy this file to .env and uncomment only what you use.
# DashScope services use DASHSCOPE_API_KEY; MODEL_API_KEY is only a custom gateway override.
# Qwen Audio 3.1 uses QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-plus and matching voice longanqian_v3.1.
# StepAudio 3 uses INTEGRATED_PROVIDER=stepfun and STEPFUN_API_KEY for voice and auxiliary chat. Local memory embeddings still require a configured embedding service.
# DOUBAO_BIGMODEL_API_KEY is the Volcengine TTS key; ASR reuse requires resource permission.
# HA_* and AUTOGLM_* are retired in Node; nonempty legacy values produce a safe migration error.
# BEGIN GENERATED ENV CONTRACT
# --- Credentials — fill only for the services you use ---
# DASHSCOPE_API_KEY=
# STEPFUN_API_KEY=
# DEEPSEEK_API_KEY=
# ARK_API_KEY=
# DOUBAO_BIGMODEL_API_KEY=
# DOUBAO_ASR_API_KEY=
# TAVILY_API_KEY=
# OPENROUTER_API_KEY=
# COMPOSIO_API_KEY=
# MODEL_API_KEY=
# CODEX_API_KEY=

# --- Conversation — integrated Qwen or cascaded ASR / LLM / TTS ---
# PROMPT_LANGUAGE=zh-CN
# NEWS_LANGUAGE=en
# PIPELINE_MODE=integrated
# INTEGRATED_PROVIDER=qwen
# STEPFUN_REALTIME_MODEL=stepaudio-3-realtime-preview
# STEPFUN_REALTIME_VOICE=
# QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
# QWEN_REALTIME_VOICE=longanqian
# CASCADE_ENDPOINTING_PROVIDER=auto
# CASCADE_ASR_PROVIDER=volcengine
# CASCADE_LLM_PROVIDER=deepseek
# CASCADE_LLM_MODEL=qwen-plus
# CASCADE_TTS_PROVIDER=volcengine
# DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts

# --- Camera and vision ---
# CAMERA_MODULE_ENABLED=true
# CONVERSATION_VISION_ENABLED=false
# MONITOR_CAMERA_DEVICE_ID=
# WATCH_MODEL=qwen3-vl-plus

# --- Coding and approvals — EXECUTORS takes precedence over the legacy EXECUTOR alias ---
# CODING_MODULE_ENABLED=true
# EXECUTORS=
# EXECUTOR=
# CODEX_WORKSPACE=
# CODEX_BIN=codex
# CODEX_APPROVAL_MODE=ask
# CODEX_PREWARM=true
# CODEX_MANAGED_ROOT=~/.nova-audio-agent/workspaces
# CODEX_PROJECT_STATE_ROOT=~/.nova-audio-agent

# --- Phone executors (opt-in) — select mobile or autoglm in EXECUTORS ---
