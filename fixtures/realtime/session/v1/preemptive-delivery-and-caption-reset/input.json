    {"kind": "provider_event", "event": {
      "kind": "response_started", "session_epoch": 1, "response_id": "resp-1"}},
    {"kind": "provider_event", "event": {
      "kind": "response_audio_delta", "session_epoch": 1, "response_id": "resp-1",
