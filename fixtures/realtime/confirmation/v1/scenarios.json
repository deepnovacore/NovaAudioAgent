{
  "schema_version": 2,
  "controller": [
    {
      "name": "confirm-then-claim-once",
      "covers": ["confirmation.structured_confirm", "confirmation.commit_authority_single_use"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "研究项目", "work_order": "开始实现", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": true},
        {"kind": "claim"},
        {"kind": "claim"}
      ]
    },
    {
      "name": "a-reconstructed-operation-cannot-commit",
      "covers": ["confirmation.commit_authority_identity"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "研究项目", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": true},
        {"kind": "claim_forged"},
        {"kind": "claim"}
      ]
    },
    {
      "name": "wrong-turn-and-wrong-id-fail-closed",
      "covers": ["confirmation.reservation", "confirmation.proposal_id_exact"],
      "steps": [
        {"kind": "prepare", "action": "select", "workspace_display_name": "alpha", "workspace_id": "workspace-alpha", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "accept", "epoch": 1, "item_id": "item-b", "proposal_id": "proposal-1", "confirmed": true},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-wrong", "confirmed": true},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": true}
      ]
    },
    {
      "name": "strict-false-cancels",
      "covers": ["confirmation.structured_cancel"],
      "steps": [
        {"kind": "prepare", "action": "select", "workspace_display_name": "alpha", "workspace_id": "workspace-alpha", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": false},
        {"kind": "claim"}
      ]
    },
    {
      "name": "non-boolean-never-confirms",
      "covers": ["confirmation.boolean_exact"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "beta", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": "true"},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": true}
      ]
    },
    {
      "name": "non-string-proposal-id-is-ignored",
      "covers": ["confirmation.proposal_id_type_exact"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "beta", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": 7, "confirmed": true},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": true}
      ]
    },
    {
      "name": "failed-transcription-cancels",
      "covers": ["confirmation.transcript_failure"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "beta", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "fail", "epoch": 1, "item_id": "item-a"},
        {"kind": "claim"}
      ]
    },
    {
      "name": "expired-proposal-never-confirms",
      "covers": ["confirmation.expiry", "confirmation.expiry_observer"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "beta", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "set_clock", "to": 400},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": true},
        {"kind": "claim"}
      ]
    },
    {
      "name": "a-new-proposal-replaces-the-one-in-flight",
      "covers": ["confirmation.single_proposal"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "alpha", "origin_ref": "conversation:1"},
        {"kind": "reserve", "epoch": 1, "item_id": "item-a"},
        {"kind": "prepare", "action": "create", "workspace_display_name": "beta", "origin_ref": "conversation:2"},
        {"kind": "accept", "epoch": 1, "item_id": "item-a", "proposal_id": "proposal-1", "confirmed": true},
        {"kind": "reserve", "epoch": 2, "item_id": "item-b"},
        {"kind": "accept", "epoch": 2, "item_id": "item-b", "proposal_id": "proposal-2", "confirmed": true}
      ]
    },
    {
      "name": "each-action-validates-resolved-boundaries",
      "covers": ["confirmation.validation", "confirmation.prompt_wording"],
      "steps": [
        {"kind": "prepare", "action": "create", "workspace_display_name": "alpha", "origin_ref": "conversation:1"},
        {"kind": "prepare", "action": "select", "workspace_display_name": "alpha", "workspace_id": "workspace-alpha", "origin_ref": "conversation:2"},
        {"kind": "prepare", "action": "resume", "workspace_display_name": "alpha", "workspace_id": "workspace-alpha", "session_title": "Task 1", "session_id": "session-1", "work_order": "continue", "origin_ref": "conversation:3"},
        {"kind": "prepare", "action": "select", "workspace_display_name": "alpha", "origin_ref": "conversation:4"},
        {"kind": "prepare", "action": "resume", "workspace_display_name": "alpha", "workspace_id": "workspace-alpha", "session_title": "Task 1", "origin_ref": "conversation:5"}
      ]
    }
  ]
}
