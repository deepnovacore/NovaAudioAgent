{
  "schema_version": 1,
  "scenarios": {
    "with-memory-recall": {
      "schemas": [
        {
          "type": "function",
          "function": {
            "name": "memory__recall",
            "description": "从当前会话的历史记忆中查找与用户问题相关的证据",
            "parameters": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "用户当前问题中需要回想的事实或结果"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "recent",
                    "any"
                  ],
                  "description": "recent 优先最近记录；any 在当前会话记忆内扩大查找"
                }
              },
              "required": [
                "query",
                "scope"
              ],
              "additionalProperties": false
            }
          }
        }
      ],
      "bindings": {
        "memory__recall": {
          "kind": "query",
          "logical_name": "memory.recall",
          "executor": null,
          "op": null,
          "sync_result": false
        }
      },
      "binding_order": [
        "memory__recall"
      ]
    },
    "one-executor": {
      "schemas": [
        {
          "type": "function",
          "function": {
            "name": "slow_sim__set_light",
            "description": "设置灯光亮度",
            "parameters": {
              "type": "object",
              "properties": {
                "brightness": {
                  "type": "integer"
                },
                "origin_ref": {
                  "type": "string",
                  "description": "当前 ContextView 中、这次动作所回答内容的 ref"
                }
              },
              "required": [
                "brightness",
                "origin_ref"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "slow_sim__read_state",
            "description": "只读查询当前状态",
            "parameters": {
              "type": "object",
              "properties": {
                "origin_ref": {
                  "type": "string",
                  "description": "当前 ContextView 中、这次动作所回答内容的 ref"
                }
              },
              "required": [
                "origin_ref"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "slow_sim__set_credential",
            "description": "带敏感参数的写操作",
            "parameters": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "origin_ref": {
                  "type": "string",
                  "description": "当前 ContextView 中、这次动作所回答内容的 ref"
                }
              },
              "required": [
                "mode",
                "token",
                "origin_ref"
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "slow_sim__sync_probe",
            "description": "同步返回结果的只读复核",
            "parameters": {
              "type": "object",
              "properties": {
                "origin_ref": {
                  "type": "string",
                  "description": "当前 ContextView 中、这次动作所回答内容的 ref"
                }
              },
              "required": [
                "origin_ref"
              ],
              "additionalProperties": false
            }
          }
        }
      ],
      "bindings": {
        "slow_sim__set_light": {
          "kind": "delegate",
          "logical_name": "slow_sim.set_light",
          "executor": "slow_sim",
          "op": "set_light",
          "sync_result": false
        },
        "slow_sim__read_state": {
          "kind": "delegate",
          "logical_name": "slow_sim.read_state",
          "executor": "slow_sim",
          "op": "read_state",
          "sync_result": false
        },
        "slow_sim__set_credential": {
          "kind": "delegate",
          "logical_name": "slow_sim.set_credential",
          "executor": "slow_sim",
          "op": "set_credential",
          "sync_result": false
        },
        "slow_sim__sync_probe": {
          "kind": "delegate",
          "logical_name": "slow_sim.sync_probe",
          "executor": "slow_sim",
          "op": "sync_probe",
          "sync_result": true
        }
      },
      "binding_order": [
        "slow_sim__set_light",
        "slow_sim__read_state",
        "slow_sim__set_credential",
        "slow_sim__sync_probe"
      ]
    },
