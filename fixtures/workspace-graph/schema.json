{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observations": {
      "type": "object",
      "properties": {
        "cases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "object",
                "properties": {
                  "observation_id": {
                    "type": "string"
                  },
                  "observation_type": {
                    "type": "string",
                    "enum": [
                      "workspace_opened",
                      "instance_observed",
                      "task_artifact_reference",
                      "task_completed",
                      "work_order_summary",
                      "user_relation_statement",
                      "provider_relation_evidence",
                      "relation_suppressed"
                    ]
                  },
                  "occurred_at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "runtime",
                      "filesystem",
                      "git",
                      "executor",
                      "user",
                      "provider"
                    ]
                  },
                  "trust": {
                    "type": "string",
                    "enum": [
                      "trusted_user",
                      "trusted_system",
                      "untrusted_external",
                      "user_confirmed"
                    ]
                  },
                  "logical_workspace_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "workspace_instance_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "related_logical_workspace_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "summary": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outcome": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "ok",
                          "unknown",
                          "failed"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "enum": [
                            "runtime",
                            "filesystem",
                            "git",
                            "executor",
                            "user",
                            "provider"
                          ]
                        },
                        "ref": {
                          "type": "string"
                        },
                        "observed_at": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "source",
                        "ref",
                        "observed_at"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "observation_id",
                  "observation_type",
                  "occurred_at",
                  "source",
                  "trust",
                  "logical_workspace_id",
                  "workspace_instance_id",
                  "related_logical_workspace_id",
                  "summary",
                  "outcome",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cases"
      ],
      "additionalProperties": false
    },
    "cards": {
      "type": "object",
      "properties": {
        "logical_workspace_cases": {
          "minItems": 1,
          "type": "array",
