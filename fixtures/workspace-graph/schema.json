            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "object",
                "properties": {
                  "logical_workspace_id": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "canonical_remote": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "created_at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "updated_at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "logical_workspace_id",
                  "display_name",
                  "aliases",
                  "canonical_remote",
                  "created_at",
                  "updated_at",
                  "revision"
