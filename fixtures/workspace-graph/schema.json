                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reason": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "enum": [
                            "runtime",
                            "filesystem",
                            "git",
                            "executor",
                            "user",
                            "provider"
                          ]
                        },
                        "ref": {
                          "type": "string"
                        },
                        "observed_at": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "source",
                        "ref",
                        "observed_at"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "first_seen_at": {
                    "type": "number",
                    "minimum": 0
