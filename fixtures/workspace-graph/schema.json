                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "workspace_instance_cases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "object",
                "properties": {
                  "instance_id": {
                    "type": "string"
                  },
                  "logical_workspace_id": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "path_label": {
                    "type": "string"
                  },
                  "branch": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "repository_fingerprint": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "inactive"
                    ]
                  },
                  "first_seen_at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "last_seen_at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "instance_id",
                  "logical_workspace_id",
                  "display_name",
                  "path_label",
                  "branch",
                  "repository_fingerprint",
                  "status",
                  "first_seen_at",
                  "last_seen_at",
                  "revision"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "logical_workspace_cases",
        "workspace_instance_cases"
